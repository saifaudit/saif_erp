80;font-size:13px;width:44%;vertical-align:top;\">Leave Type</td><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#111827;font-size:13px;font-weight:600;vertical-align:top;\">{{ doc.leave_type }}</td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#6b7280;font-size:13px;width:44%;vertical-align:top;\">From</td><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#111827;font-size:13px;font-weight:600;vertical-align:top;\">{{ frappe.utils.format_date(doc.from_date) }}{% if doc.half_day %} (Half day){% endif %}</td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#6b7280;font-size:13px;width:44%;vertical-align:top;\">To</td><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#111827;font-size:13px;font-weight:600;vertical-align:top;\">{{ frappe.utils.format_date(doc.to_date) }}</td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#6b7280;font-size:13px;width:44%;vertical-align:top;\">Total Days</td><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#111827;font-size:13px;font-weight:600;vertical-align:top;\">{{ doc.total_leave_days }}</td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#6b7280;font-size:13px;width:44%;vertical-align:top;\">Actioned By</td><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#111827;font-size:13px;font-weight:600;vertical-align:top;\">{{ approver }}</td></tr></table></td></tr></table>{% endif %}<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:22px 0 2px;\"><tr><td style=\"background:#16794c;border-radius:7px;\"><a href=\"{{ frappe.utils.get_url() }}/app/leave-application/{{ doc.name }}\" style=\"display:inline-block;padding:12px 26px;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none;\">View Leave Application →</a></td></tr></table><p style=\"margin:22px 0 0;color:#374151;font-size:13px;\">Regards,<br><strong>SGA World ERP</strong></p></td></tr><tr><td style=\"background:#f6f8f7;padding:15px 28px;border:1px solid #e3e8e5;border-top:none;border-radius:0 0 10px 10px;\"><div style=\"color:#8a938d;font-size:11px;line-height:1.5;\">This is an automated message from the SGA World &middot; SAIF ERP. Please do not reply to this email.</div></td></tr></table></div>",
