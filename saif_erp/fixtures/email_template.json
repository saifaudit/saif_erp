id #edf1ef;color:#111827;font-size:13px;font-weight:600;vertical-align:top;\">{{ doc.leave_type }}</td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#6b7280;font-size:13px;width:44%;vertical-align:top;\">From</td><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#111827;font-size:13px;font-weight:600;vertical-align:top;\">{{ frappe.utils.format_date(doc.from_date) }}{% if doc.half_day %} (Half day){% endif %}</td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#6b7280;font-size:13px;width:44%;vertical-align:top;\">To</td><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#111827;font-size:13px;font-weight:600;vertical-align:top;\">{{ frappe.utils.format_date(doc.to_date) }}</td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#6b7280;font-size:13px;width:44%;vertical-align:top;\">Total Days</td><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#111827;font-size:13px;font-weight:600;vertical-align:top;\">{{ doc.total_leave_days }}</td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#6b7280;font-size:13px;width:44%;vertical-align:top;\">Reason</td><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#111827;font-size:13px;font-weight:600;vertical-align:top;\">{{ doc.description or '—' }}</td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#6b7280;font-size:13px;width:44%;vertical-align:top;\">Leave Balance</td><td style=\"padding:10px 0;border-bottom:1px solid #edf1ef;color:#111827;font-size:13px;font-weight:600;vertical-align:top;\">{{ doc.leave_balance if doc.leave_balance is not none else '—' }}</td></tr></table></td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:22px 0 2px;\"><tr><td style=\"background:#16794c;border-radius:7px;\"><a href=\"{{ frappe.utils.get_url() }}/app/leave-application/{{ doc.name }}\" style=\"display:inline-block